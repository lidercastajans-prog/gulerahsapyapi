# Sanity CMS yapılandırması
# https://sanity.io/manage adresinden ücretsiz hesap aç, proje oluştur,
# ardından bu üç değeri buraya kopyala. Dosyayı .env.local olarak kaydet.

# Project Settings > API > Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Genelde "production" yeterli
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API'nin sürüm tarihi — değiştirmeye gerek yok
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Sadece seed scripti için gerekli (tek seferlik veri yükleme).
# Settings > API > Tokens > "Editor" yetkisinde token oluştur ve buraya yapıştır.
# Bu token GİZLİDİR — git'e commit etmeyin.
SANITY_API_WRITE_TOKEN=
